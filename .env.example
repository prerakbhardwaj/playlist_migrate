# ============================================================
# SPOTIFY CREDENTIALS
# Get these from: https://developer.spotify.com/dashboard
# 1. Log in → Create App → copy Client ID and Client Secret
# 2. Add http://127.0.0.1:8888/callback as a Redirect URI
# ============================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ============================================================
# GOOGLE / YOUTUBE CREDENTIALS
# Get these from: https://console.cloud.google.com/
# 1. Create a project → Enable "YouTube Data API v3"
# 2. Go to APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Choose "TV and Limited Input" as the application type
# 4. Copy Client ID and Client Secret below
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
