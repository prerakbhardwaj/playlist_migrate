# ── Credentials & secrets ─────────────────────────────────────────────────────
# Your actual credentials - never commit this, use .env.example as template
.env
# Live YouTube OAuth tokens (regenerated by setup_oauth.py)
oauth.json
# Live Spotify OAuth tokens (auto-generated by spotipy)
.cache
# YouTube Music browser cookies (refreshed via refresh_auth.py)
headers.txt
browser.json

# ── Personal data (full library exports) ──────────────────────────────────────
# These are user-specific - each person generates their own when running the scripts
spotify_all_playlists.csv
ytmusic_all_playlists.csv
missing_songs.csv
not_found.csv
# Tracks which songs have already been imported - user-specific
import_progress.json

# ── Python ────────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

